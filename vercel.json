{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:pages",
  "outputDirectory": "out",
  "headers": [
    {
      "source": "/app-data/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ]
}
