{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:pages",
  "outputDirectory": "out",
  "headers": [
    {
      "source": "/app-data/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/profissionais/dr-wenner-terra-freitas-otorrino-piumhi{/}?",
      "destination": "/profissionais/dr-wenner-terra-freitas-otorrinolaringologia-piumhi/",
      "permanent": true
    },
    {
      "source": "/profissionais/dra-wanessa-dornela-de-oliveira-otorrino-piumhi{/}?",
      "destination": "/profissionais/dra-wanessa-dornela-de-oliveira-otorrinolaringologia-piumhi/",
      "permanent": true
    },
    {
      "source": "/profissionais/dr-rui-manuel-dos-prazeres-xavier-ginecologia-piumhi{/}?",
      "destination": "/buscar/?cidade=Piumhi&tipo=professionals&especialidade=Ginecologia",
      "permanent": true
    },
    {
      "source": "/profissionais/dra-graziele-paiz-clinica-medica{/}?",
      "destination": "/profissionais/dra-graziele-paiz-clinica-medica-piumhi/",
      "permanent": true
    }
  ]
}
