{
  "name": "guia-saude-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "optimize:professional-images": "node --import tsx scripts/optimize-professional-images.ts",
    "predev": "npm run optimize:professional-images",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run optimize:professional-images",
    "build": "npm run build:web",
    "build:web": "NEXT_PUBLIC_BUILD_TARGET=web next build && node scripts/apply-public-site.mjs",
    "build:pages": "NEXT_PUBLIC_BUILD_TARGET=app npm run optimize:professional-images && npm run validate:css && npm run validate:directory && npm run validate:search && npm run validate:audit && npm run validate:podcast && NEXT_PUBLIC_BUILD_TARGET=app next build && node scripts/postbuild-seo.mjs && node --import tsx scripts/validate-public-directory.ts --check-sitemap && node scripts/apply-public-site.mjs",
    "deploy:manual": "bash scripts/deploy-manual.sh",
    "build:app": "npm run build:pages && node scripts/strip-admin-routes.mjs && npx cap sync",
    "app:sync": "npx cap sync",
    "app:android": "npm run build:app && npx cap open android",
    "app:ios": "npm run build:app && npx cap open ios",
    "app:assets": "npx capacitor-assets generate --android --ios",
    "validate:seo": "node scripts/validate-seo.mjs",
    "validate:service-import": "node scripts/validate-service-import.mjs",
    "validate:professionals": "node scripts/validate-professionals.mjs",
    "validate:directory": "node --import tsx scripts/validate-public-directory.ts",
    "validate:search": "node scripts/validate-search-coverage.mjs",
    "validate:podcast": "node scripts/validate-podcast-participants.mjs",
    "validate:audit": "node --import tsx scripts/validate-directory-audit.ts",
    "validate:css": "node scripts/validate-css-architecture.mjs",
    "validate:release": "npm run lint && npm run validate:css && npm run validate:professionals && npm run build:pages && npm run validate:seo",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build:pages && node --test tests/*.test.mjs",
    "lint": "eslint app components lib db scripts tests server-admin server-api worker *.ts *.mjs --no-warn-ignored",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.24.0",
    "next": "^16.3.5",
    "page-flip": "^2.0.7",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.5",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.35.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
